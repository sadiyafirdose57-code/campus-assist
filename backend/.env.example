PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campus_assist
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
COLLEGE_NAME=Your College Name

# Anyone registering with these emails becomes an admin (can upload documents)
CAMPUS_ADMIN_EMAILS=admin@college.edu

# AI provider: anthropic | openai | google  (leave empty = auto-detect from keys)
# With no key at all the bot still works: it shows the best matching passages.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
